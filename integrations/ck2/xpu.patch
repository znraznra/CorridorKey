+def _queue_put(writer, item):
+    # Encoder or EXR worker failures must not leave a producer blocked on a
+    # full queue after the consumer has exited.
+    while True:
+        if writer.err is not None:
+            raise writer.err
+        try:
+            writer.q.put(item, timeout=0.1)
+            return
+        except queue.Full:
+            if not writer.thread.is_alive():
+                raise RuntimeError("CorridorKey output worker stopped unexpectedly")
+
+
+def _finish_writer_thread(writer):
+    try:
+        _queue_put(writer, None)
+    except Exception as exc:
+        writer.err = exc
+    writer.thread.join()
 
 
